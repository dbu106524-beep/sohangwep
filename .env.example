NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_HOST=0.0.0.0
WEB_PORT=3000

NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects should prefer the publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are still supported by the app as a fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Discord OAuth is configured in the Supabase dashboard.
# Add the callback URL:
# http://localhost:3000/auth/callback

# Comma-separated Discord user IDs that can access /admin.
ADMIN_DISCORD_IDS=123456789012345678

# Payment test mode. Keep real PG keys empty until integration.
PAYMENT_MODE=test
PAYMENT_WEBHOOK_SECRET=test_secret_change_me

# Internal fulfillment and future Minecraft plugin integration.
INTERNAL_FULFILLMENT_KEY=dev_internal_fulfillment_key
MINECRAFT_GRANT_API_KEY=dev_minecraft_plugin_key
MINECRAFT_SERVER_GRANT_URL=

# Local Minecraft server startup.
# Put your real values in .env.local, not in git.
MC_SERVER_DIR=C:\path\to\minecraft-server
MC_SERVER_START_SCRIPT=start.bat
